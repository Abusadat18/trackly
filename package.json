{
  "name": "trackly",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Employee time tracking and productivity platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "npx prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:seed": "npx ts-node apps/api/prisma/seed.ts",
    "db:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --schema=apps/api/prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
